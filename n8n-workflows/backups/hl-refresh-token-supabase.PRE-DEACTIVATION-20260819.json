                "jsCode": "// Log the error and return error information\nconsole.error('Token refresh failed:', $json);\n\nreturn [{\n  json: {\n    status: 'error',\n    error: $json.error || 'Unknown error',\n    error_description: $json.error_description || 'Token refresh failed',\n    timestamp: new Date().toISOString()\n  }\n}];"
