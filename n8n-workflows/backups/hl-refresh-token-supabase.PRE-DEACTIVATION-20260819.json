            "parameters": {
                "jsCode": "// Get credentials from environment variables\nlet client_id, client_secret;\n\nif ($env.HL_LOCATION1_CLIENT_ID && $env.HL_LOCATION1_CLIENT_SECRET) {\n  client_id = $env.HL_LOCATION1_CLIENT_ID;\n  client_secret = $env.HL_LOCATION1_CLIENT_SECRET;\n} else {\n  throw new Error('HighLevel Location 1 credentials not found in environment variables');\n}\n\nreturn [{\n  json: {\n    ...$json,\n    client_id: client_id,\n    client_secret: client_secret\n  }\n}];"
