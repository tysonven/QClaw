        {
            "parameters": {
                "jsCode": "// Log the error when no refresh token is found in database\nconsole.error('No refresh token found in database');\n\nreturn [{\n  json: {\n    status: 'error',\n    error: 'no_refresh_token',\n    error_description: 'No refresh token found in database. Please run initial OAuth flow.',\n    timestamp: new Date().toISOString()\n  }\n}];"
            },
