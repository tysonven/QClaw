        {
            "parameters": {
                "jsCode": "// Extract tokens from the refresh response\nconst accessToken = $json.access_token;\nconst refreshToken = $json.refresh_token;\nconst expiresIn = $json.expires_in || 86400; // Default 24 hours\n\n// Calculate expiration time\nconst now = new Date();\nconst expirationTime = new Date(now.getTime() + (expiresIn * 1000));\n\n// Log the refresh success\nconsole.log('Token refresh successful!');\nconsole.log('New access token expires at:', expirationTime.toISOString());\nconsole.log('New refresh token received:', refreshToken ? 'Yes' : 'No');\n\n// Return the token data for storage\nreturn [{\n  json: {\n    access_token: accessToken,\n    refresh_token: refreshToken,\n    expires_at: expirationTime.toISOString(),\n    expires_in: expiresIn,\n    refreshed_at: now.toISOString(),\n    status: 'success'\n  }\n}];"
            },
